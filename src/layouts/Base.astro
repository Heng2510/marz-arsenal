---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <script is:inline>
    (function () {
      const saved = localStorage.getItem('marz-theme');
      if (saved === 'dark') document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="min-h-screen">
  <header class="border-b-4 border-double border-stone-800 dark:border-stone-200 bg-stone-100 dark:bg-stone-900">
    <div class="max-w-7xl mx-auto px-4 py-6 relative">
      <div class="absolute top-4 right-4 flex gap-2 items-center text-xs">
        <button id="theme-toggle"
          class="px-3 py-1 border border-stone-800 dark:border-stone-200 font-bold uppercase tracking-wider">
          🌙 Dark
        </button>
      </div>
      <div class="text-center">
        <h1 class="text-5xl font-black tracking-tight">THE MARZ ARSENAL</h1>
        <p class="text-sm uppercase tracking-widest mt-2 text-stone-600 dark:text-stone-400">
          Guns · Ammo · Attachments · Best Choice — Project Zomboid Mod
        </p>
      </div>
    </div>
  </header>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <slot />
  </main>
  <footer class="border-t border-stone-400 dark:border-stone-600 mt-16 py-6 text-center text-xs text-stone-500 dark:text-stone-400">
    Data extracted from MarzGuns mod. Best choice is editorial.
  </footer>

  <script>
    const toggle = document.getElementById('theme-toggle')!;
    function render() {
      const dark = document.documentElement.classList.contains('dark');
      toggle.textContent = dark ? '☀️ Light' : '🌙 Dark';
    }
    toggle.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('marz-theme', dark ? 'dark' : 'light');
      render();
    });
    render();
  </script>
</body>
</html>