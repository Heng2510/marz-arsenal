---
import "../styles/global.css";
import Base from "../layouts/Base.astro";
import Tabs from "../components/Tabs.astro";
import FilterBar from "../components/FilterBar.astro";
import GunTable from "../components/GunTable.astro";
import AttachmentTable from "../components/AttachmentTable.astro";
import LoadoutTab from "../components/LoadoutTab.astro";
import { GUNS } from "../data/guns";
import { AMMO_INFO } from "../data/ammo";
import { GUN_META } from "../data/gun-meta";
import { SCORED_GUNS, PROFILES, expectedDamage } from "../lib/scoring";

// Pre-computed scored guns (includes per-profile score + global rank)
const scoredGuns = SCORED_GUNS;
const profiles = PROFILES;

// Ammo grouping for the Ammo tab
// A gun can belong to multiple families (e.g. .38 and .357), so it appears in each group.
const byAmmo: Record<string, string[]> = {};
for (const g of GUNS) {
	for (const fam of g.ammoFamilies) {
		(byAmmo[fam] ??= []).push(g.name);
	}
}

const categories = [...new Set(GUNS.map((g) => g.category))].sort();
const ammoKeys = Object.keys(AMMO_INFO);
---

<Base title="Marz Arsenal">
	<Tabs />

	<!-- ============ GUNS ============ -->
	<section data-panel="guns">
		<div class="mb-4 flex items-center justify-between">
			<h2 class="text-2xl font-black uppercase">Guns ({GUNS.length})</h2>
			<div class="text-xs italic text-stone-600 dark:text-stone-400">
				★ = best choice · Click header to sort
			</div>
		</div>
		<FilterBar />
		<GunTable />
	</section>

	<!-- ============ AMMO ============ -->
	<section data-panel="ammo" hidden>
		<h2 class="text-2xl font-black uppercase mb-4">Grouped by Ammo</h2>
		<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
			{
				Object.entries(byAmmo)
					.sort()
					.map(([key, guns]) => {
						const info = AMMO_INFO[key as keyof typeof AMMO_INFO];
						return (
							<div class:list={["border-2 p-4", `ammo-${key}`]}>
								<h3 class="font-black text-lg">
									{info.label}
									<span class="text-xs font-normal opacity-70">
										{" "}
										— {info.long}
									</span>
								</h3>
								<p class="text-xs mt-1">{guns.length} guns</p>
								<ul class="text-sm mt-2 list-disc list-inside">
									{guns.map((n) => (
										<li>{n}</li>
									))}
								</ul>
							</div>
						);
					})
			}
		</div>
	</section>

	<!-- ============ ATTACHMENTS ============ -->
	<section data-panel="attachments" hidden>
		<h2 class="text-2xl font-black uppercase mb-4">Attachments</h2>
		<AttachmentTable />
	</section>

	<!-- ============ LOADOUT ============ -->
	<section data-panel="loadout" hidden>
		<LoadoutTab />
	</section>

	<!-- ============ RANKING ============ -->
	<section data-panel="ranking" hidden>
		<div class="mb-4">
			<h2 class="text-2xl font-black uppercase">
				Ranking ({scoredGuns.length})
			</h2>
			<p class="text-xs italic text-stone-600 dark:text-stone-400 mt-1">
				Ranked by the selected profile. Filters do not change global
				rank. Click any header to sort.
			</p>
		</div>

		<!-- Filter bar -->
		<div
			class="border-2 border-stone-800 dark:border-stone-200 bg-stone-100 dark:bg-stone-900 p-3 mb-4 flex flex-wrap gap-3 items-end text-sm"
		>
			<label class="flex flex-col text-xs">
				<span class="font-bold uppercase mb-1">Profile</span>
				<select
					id="r-profile"
					class="border border-stone-500 px-2 py-1 min-w-[140px]"
				>
					{
						profiles.map((p) => (
							<option value={p.id}>{p.label}</option>
						))
					}
				</select>
			</label>
			<label class="flex flex-col text-xs">
				<span class="font-bold uppercase mb-1">Category</span>
				<select
					id="r-cat"
					class="border border-stone-500 px-2 py-1 min-w-[120px]"
				>
					<option value="">All</option>
					{categories.map((c) => <option value={c}>{c}</option>)}
				</select>
			</label>
			<label class="flex flex-col text-xs">
				<span class="font-bold uppercase mb-1">Ammo</span>
				<select
					id="r-ammo"
					class="border border-stone-500 px-2 py-1 min-w-[180px]"
				>
					<option value="">All</option>
					{
						ammoKeys.map((k) => (
							<option value={k}>
								{AMMO_INFO[k as keyof typeof AMMO_INFO].label}
							</option>
						))
					}
				</select>
			</label>
			<label class="flex flex-col text-xs flex-1 min-w-[160px]">
				<span class="font-bold uppercase mb-1">Search</span>
				<input
					id="r-q"
					type="text"
					placeholder="Search by name…"
					class="border border-stone-500 px-2 py-1 w-full"
				/>
			</label>
			<div class="text-xs ml-auto">
				Showing <b id="r-count" class="mx-1">0</b> of <b class="mx-1"
					>{scoredGuns.length}</b
				>
			</div>
		</div>

		<!-- Ranking table -->
		<div
			class="overflow-x-auto border-2 border-stone-800 dark:border-stone-200"
		>
			<table class="w-full text-sm border-collapse table-fixed">
				<colgroup>
					<col style="width:50px" />
					<col style="width:140px" />
					<col style="width:90px" />
					<col style="width:90px" />
					<col style="width:70px" />
					<col style="width:70px" />
					<col style="width:70px" />
					<col style="width:70px" />
					<col style="width:60px" />
					<col style="width:70px" />
					<col style="width:70px" />
					<col style="width:60px" />
					<col style="width:60px" />
					<col style="width:70px" />
				</colgroup>
				<thead
					class="bg-stone-800 dark:bg-stone-200 text-stone-50 dark:text-stone-900"
				>
					<tr>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="rank"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>#<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="rank">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-left cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="name"
						>
							<span class="inline-flex items-center gap-1"
								>Gun<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="name">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-left cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="category"
						>
							<span class="inline-flex items-center gap-1"
								>Type<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="category">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-left cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="ammo"
						>
							<span class="inline-flex items-center gap-1"
								>Ammo<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="ammo">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="score"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Score<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="score">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="balancedRank"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Bal. Rank<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="balancedRank">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="dmgMax"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>DMG<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="dmgMax">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="expDmg"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Exp. DMG<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="expDmg">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="crit"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Crit%<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="crit">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="range"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Range<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="range">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="noise"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Noise<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="noise">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="aimTime"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Aim<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="aimTime">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="weight"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Wt<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="weight">▼</span
								></span
							>
						</th>
						<th
							class="p-2 text-right cursor-pointer select-none hover:bg-stone-700 dark:hover:bg-stone-300"
							data-r-sort-key="attach"
						>
							<span
								class="inline-flex items-center gap-1 justify-end"
								>Attach<span
									class="r-sort-icon text-[10px] opacity-40"
									data-r-icon="attach">▼</span
								></span
							>
						</th>
					</tr>
				</thead>
				<tbody id="rank-tbody">
					{
						scoredGuns.map((g) => {
							const meta = GUN_META[g.name] ?? {};
							return (
								<tr
									class:list={[
										"border-b border-stone-300 dark:border-stone-700",
										g.best &&
											"bg-amber-50 dark:bg-amber-900/30",
									]}
									data-name={g.name.toLowerCase()}
									data-cat={g.category}
									data-ammo={g.ammoFamilies.join(",")}
									data-scores={JSON.stringify(g.scores)}
									data-ranks={JSON.stringify(g.globalRanks)}
									data-dmg-max={g.dmgMax}
									data-exp-dmg={expectedDamage(
										g.dmgMax,
										g.crit,
										g.critDmg,
									).toFixed(3)}
									data-crit={g.crit}
									data-range={g.range}
									data-noise={g.noise}
									data-aim={g.aimTime}
									data-weight={g.weight}
									data-attach={meta.attachCount ?? 0}
								>
									<td class="p-2 num text-right font-mono font-bold rank-cell">
										—
									</td>
									<td class="p-2 font-bold">
										{g.best ? "★ " : ""}
										{g.name}
									</td>
									<td class="p-2 text-xs uppercase text-stone-600 dark:text-stone-400">
										{g.category}
									</td>
									<td class="p-2">
										{g.ammoFamilies.length === 0 ? (
											<span class="text-stone-400 italic">
												—
											</span>
										) : (
											<div class="flex flex-wrap gap-1">
												{g.ammoFamilies.map((f) => (
													<span
														class:list={[
															"px-2 py-0.5 text-xs border rounded whitespace-nowrap",
															AMMO_INFO[f].color,
														]}
														title={
															AMMO_INFO[f].long
														}
													>
														{AMMO_INFO[f].label}
													</span>
												))}
											</div>
										)}
									</td>
									<td class="p-2 num text-right font-mono score-cell">
										—
									</td>
									<td class="p-2 num text-right font-mono rank-balanced-cell">
										—
									</td>
									<td class="p-2 num text-right font-mono">
										{g.dmgMax}
									</td>
									<td class="p-2 num text-right font-mono">
										{expectedDamage(
											g.dmgMax,
											g.crit,
											g.critDmg,
										).toFixed(2)}
									</td>
									<td class="p-2 num text-right font-mono">
										{g.crit}
									</td>
									<td class="p-2 num text-right font-mono">
										{g.range}
									</td>
									<td class="p-2 num text-right font-mono">
										{g.noise}
									</td>
									<td class="p-2 num text-right font-mono">
										{g.aimTime}
									</td>
									<td class="p-2 num text-right font-mono">
										{g.weight}
									</td>
									<td class="p-2 num text-right font-mono">
										{meta.attachCount ?? 0}
									</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
	</section>
</Base>

<script>
	// ---------- RANKING: filter + sort (profile score by default, manual on click) ----------
	const rProfile = document.getElementById(
		"r-profile",
	) as HTMLSelectElement | null;
	const rCat = document.getElementById("r-cat") as HTMLSelectElement | null;
	const rAmmo = document.getElementById("r-ammo") as HTMLSelectElement | null;
	const rQ = document.getElementById("r-q") as HTMLInputElement | null;
	const rCount = document.getElementById("r-count");
	const rankTbody = document.getElementById("rank-tbody");

	// Manual sort state: 0 = off, 1 = asc, 2 = desc
	let rCurrentKey: string | null = null;
	const rSortState: Record<string, 0 | 1 | 2> = {};

	function rUpdateIcons() {
		document
			.querySelectorAll<HTMLElement>("[data-r-icon]")
			.forEach((el) => {
				const key = el.dataset.rIcon!;
				const state = key === rCurrentKey ? rSortState[key] || 0 : 0;
				if (state === 1) {
					el.textContent = "▲";
					el.style.opacity = "1";
				} else if (state === 2) {
					el.textContent = "▼";
					el.style.opacity = "1";
				} else {
					el.textContent = "▼";
					el.style.opacity = "0.4";
				}
			});
	}

	function rGetValue(tr: HTMLTableRowElement, key: string): string | number {
		if (key === "rank") {
			const cell = tr.querySelector(".rank-cell");
			return parseInt(cell?.textContent ?? "999", 10) || 999;
		}
		if (key === "score") {
			const profile = rProfile?.value ?? "balanced";
			return JSON.parse(tr.dataset.scores || "{}")[profile] ?? 0;
		}
		if (key === "balancedRank") {
			return JSON.parse(tr.dataset.ranks || "{}")["balanced"] ?? 999;
		}
		if (key === "name") return (tr.dataset.name || "").toLowerCase();
		if (key === "category") return tr.dataset.cat || "";
		if (key === "ammo") return tr.dataset.ammo || "";
		const map: Record<string, string> = {
			dmgMax: "dmgMax",
			expDmg: "expDmg",
			crit: "crit",
			range: "range",
			noise: "noise",
			aimTime: "aim",
			weight: "weight",
			attach: "attach",
		};
		const attr = map[key];
		if (attr) return parseFloat(tr.dataset[attr] || "0") || 0;
		return 0;
	}

	function applyRank() {
		if (!rankTbody || !rCount) return;
		const profile = rProfile?.value ?? "balanced";
		const cat = rCat?.value ?? "";
		const ammo = rAmmo?.value ?? "";
		const q = (rQ?.value ?? "").trim().toLowerCase();

		const rows = Array.from(
			rankTbody.querySelectorAll<HTMLTableRowElement>("tr"),
		);

		// Default sort: profile score descending. Only when no manual sort is active.
		if (!rCurrentKey) {
			rows.sort((a, b) => {
				const sa = JSON.parse(a.dataset.scores || "{}")[profile] ?? 0;
				const sb = JSON.parse(b.dataset.scores || "{}")[profile] ?? 0;
				return sb - sa;
			});
		}

		let visible = 0;
		for (const tr of rows) {
			const scores = JSON.parse(tr.dataset.scores || "{}");
			const ranks = JSON.parse(tr.dataset.ranks || "{}");

			const fams = (tr.dataset.ammo || "").split(",").filter(Boolean);
			const ok =
				(!cat || tr.dataset.cat === cat) &&
				(!ammo || fams.includes(ammo)) &&
				(!q || (tr.dataset.name || "").includes(q));

			tr.hidden = !ok;

			const rankCell = tr.querySelector(".rank-cell") as HTMLElement;
			if (rankCell) rankCell.textContent = String(ranks[profile] ?? "—");

			const scoreCell = tr.querySelector(".score-cell") as HTMLElement;
			if (scoreCell) {
				const s = scores[profile] ?? 0;
				scoreCell.textContent = (s * 100).toFixed(1);
			}

			const balCell = tr.querySelector(
				".rank-balanced-cell",
			) as HTMLElement;
			if (balCell) balCell.textContent = String(ranks["balanced"] ?? "—");

			if (ok) visible++;
			rankTbody.appendChild(tr);
		}
		rCount.textContent = String(visible);
		rUpdateIcons();
	}

	// Manual sort: 3-click cycle asc → desc → reset (back to profile sort)
	document
		.querySelectorAll<HTMLTableCellElement>("[data-r-sort-key]")
		.forEach((th) => {
			th.addEventListener("click", () => {
				if (!rankTbody) return;
				const key = th.dataset.rSortKey!;

				if (rCurrentKey && rCurrentKey !== key)
					rSortState[rCurrentKey] = 0;

				const cur = rSortState[key] || 0;
				const next: 0 | 1 | 2 = cur === 0 ? 1 : cur === 1 ? 2 : 0;
				rSortState[key] = next;
				rCurrentKey = key;

				if (next === 0) {
					rCurrentKey = null;
					applyRank();
					return;
				}

				const rows = Array.from(
					rankTbody.querySelectorAll<HTMLTableRowElement>("tr"),
				);
				rows.sort((a, b) => {
					const va = rGetValue(a, key);
					const vb = rGetValue(b, key);
					let cmp = 0;
					if (typeof va === "number" && typeof vb === "number")
						cmp = va - vb;
					else cmp = String(va).localeCompare(String(vb));
					return next === 1 ? cmp : -cmp;
				});
				rows.forEach((r) => rankTbody.appendChild(r));
				rUpdateIcons();
			});
		});

	// Profile change → reset manual sort
	rProfile?.addEventListener("change", () => {
		rCurrentKey = null;
		Object.keys(rSortState).forEach((k) => (rSortState[k] = 0));
		applyRank();
	});
	rCat?.addEventListener("change", applyRank);
	rAmmo?.addEventListener("change", applyRank);
	rQ?.addEventListener("input", applyRank);

	applyRank();
</script>
