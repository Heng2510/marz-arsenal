---
import { GUNS } from '../data/guns';
import { AMMO_INFO } from '../data/ammo';
const ammoKeys = Object.keys(AMMO_INFO);
const categories = [...new Set(GUNS.map(g => g.category))].sort();
---
<div class="border-2 border-stone-800 dark:border-stone-200 bg-stone-100 dark:bg-stone-900 p-3 mb-4 flex flex-wrap gap-3 items-end text-sm">
  <label class="flex flex-col text-xs">
    <span class="font-bold uppercase mb-1">Ammo type</span>
    <select id="f-ammo" class="border border-stone-500 px-2 py-1 min-w-[180px]">
      <option value="">All</option>
      {ammoKeys.map(k => <option value={k}>{AMMO_INFO[k as keyof typeof AMMO_INFO].label}</option>)}
    </select>
  </label>
  <label class="flex flex-col text-xs">
    <span class="font-bold uppercase mb-1">Gun category</span>
    <select id="f-cat" class="border border-stone-500 px-2 py-1 min-w-[140px]">
      <option value="">All</option>
      {categories.map(c => <option value={c}>{c}</option>)}
    </select>
  </label>
  <label class="flex flex-col text-xs flex-1 min-w-[200px]">
    <span class="font-bold uppercase mb-1">Search</span>
    <input id="f-q" type="text" placeholder="Search by name…" class="border border-stone-500 px-2 py-1 w-full" />
  </label>
  <div class="text-xs ml-auto">
    Showing <b id="f-count" class="mx-1">0</b> of <b class="mx-1">{GUNS.length}</b> guns
  </div>
</div>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLInputElement | HTMLSelectElement;
  const countEl = document.getElementById('f-count')!;
  function applyFilter() {
    const ammo = ($('#f-ammo') as HTMLSelectElement).value;
    const cat  = ($('#f-cat') as HTMLSelectElement).value;
    const q    = ($('#f-q') as HTMLInputElement).value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll<HTMLTableRowElement>('#guns-tbody tr').forEach(tr => {
      const ok = (!ammo || tr.dataset.ammo === ammo)
              && (!cat  || tr.dataset.cat  === cat)
              && (!q    || (tr.dataset.name || '').toLowerCase().includes(q));
      tr.hidden = !ok;
      if (ok) visible++;
    });
    countEl.textContent = String(visible);
  }
  ['#f-ammo', '#f-cat', '#f-q'].forEach(s =>
    document.querySelector(s)?.addEventListener('input', applyFilter)
  );
  applyFilter();
</script>